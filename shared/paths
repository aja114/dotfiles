# Shared PATH entries, appended by both zsh (.zshenv) and nushell (env.nu).
# One entry per line; $HOME is expanded by both loaders. Order is preserved
# and duplicates are removed by the loaders.

$HOME/.local/bin
$HOME/.cargo/bin
# goenv shims: make go/gofmt/gopls/dlv resolve without `goenv init` (~60ms).
# zsh re-prepends them in .zshrc to guarantee priority; here they serve nushell.
$HOME/.goenv/shims
/opt/homebrew/opt/goenv/bin
/opt/homebrew/bin
/opt/homebrew/sbin
